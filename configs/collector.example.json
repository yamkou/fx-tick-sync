{
  "schema_version": 1,
  "environment": "development",
  "paths": {
    "data_root": "runtime/data",
    "temp_root": "runtime/temp",
    "log_root": "runtime/logs",
    "export_root": "runtime/exports",
    "provenance_registry": "private-config/reference-ledger.json"
  },
  "collectors": [
    {
      "collector_id": "london-01",
      "location": "london",
      "source_type": "dukascopy",
      "broker": "dukascopy",
      "symbols": ["XAUUSD", "EURUSD"],
      "storage_destination": "private-buffer"
    }
  ],
  "terminals": [],
  "storage": [
    {
      "storage_id": "private-buffer",
      "kind": "local",
      "zone": "PRIVATE_REFERENCE",
      "location": "runtime/data"
    }
  ]
}
